<resources>
    <!--
      Google Sign-In "Web client ID" (OAuth 2.0 client ID for a Web
      application) from the Firebase project. This is NOT a secret, but it
      must match the Firebase project in google-services.json.

      HOW TO FILL IT IN:
      1. In the Firebase console, open Authentication -> Sign-in method and
         enable the Google provider.
      2. The Web client ID is shown there, and it also appears in the
         re-downloaded google-services.json as the oauth_client entry with
         "client_type": 3.
      3. Replace the placeholder below with that client ID
         (looks like 88671737361-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com).

      Until this is replaced, "Sign in with Google" will show an error
      instead of opening the account picker. The Android OAuth client
      (SHA-1 of the release keystore) must also be registered in Google
      Cloud, otherwise sign-in will fail after the account is picked.
    -->
    <string name="google_web_client_id" translatable="false">88671737361-bqamnu24jukd43t4s8hjo30ljuq4be84.apps.googleusercontent.com</string>
</resources>
